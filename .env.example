# ── Syndicate OS configuration ────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit the real .env.

# LLM provider key for the Hermes agents (DeepSeek / OpenAI / OpenRouter / ...)
LLM_API_KEY=sk-your-key-here

# How many agents to seed, and their names (comma-separated)
AGENT_NAMES=athena,nyx,iris

# Provider + model for the agents (see `hermes model` for the catalog)
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-flash

# ── Ports ────────────────────────────────────────────────────────────────
FEDERATION_PORT=8080
SEMANTICA_PORT=8765
EXPLORER_PORT=8000
MONGO_PORT=27017

# ── Federation service ───────────────────────────────────────────────────
# Where the provenance API lives (inside docker it is the compose service name)
SEMANTICA_API=http://localhost:8765
# Hermes binary used by dispatch (host side)
HERMES_BIN=hermes
# Dispatch timeout per agent run (seconds)
DISPATCH_TIMEOUT=300

# ── Desktop app registry (optional) ──────────────────────────────────────
# If set, register-connections.py also registers these agents' dashboards.
# Format: name|http://host:port[|session-token] per line
# DESKTOP_AGENTS_FILE=desktop-agents.txt
