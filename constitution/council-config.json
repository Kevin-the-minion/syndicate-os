{
  "name": "syndicate-council",
  "version": "0.2.0",
  "principles": [
    "Altruism is a founding principle: agents are net givers. Fitness = altruism / self; the scoreboard ranks givers first.",
    "Evidence is mandatory: every outcome closes with a real, verifiable artifact.",
    "Provenance is sacred: every decision is a node + edge in the Semantica graph.",
    "Debate before fix: audit -> debate -> fix -> verify. Never audit -> fix -> debate.",
    "The operator is human: money and destructive actions require explicit GO."
  ],
  "hierarchy": [
    "Operator (human) — final authority",
    "Council lead — synthesis and dispatch",
    "Lane leads — domain authority within their lane",
    "TRIO mandate: every convening includes skeptic + verifier + ux; minimum 5 participants"
  ],
  "trio": {
    "enabled": true,
    "roles": "skeptic, verifier, ux"
  },
  "models": {
    "providers": {
      "ollama-local": {
        "api": "ollama",
        "baseUrl": "http://localhost:11434"
      },
      "deepseek": {
        "api": "openai",
        "baseUrl": "https://api.deepseek.com/v1"
      }
    }
  },
  "lanes": [
    {"id": 1, "domain": "SEC/AUDIT", "lead": "guardian", "reviewer": "skeptic"},
    {"id": 2, "domain": "CFG/MOD", "lead": "tinker", "reviewer": "verifier"},
    {"id": 3, "domain": "MEM/DATA", "lead": "librarian", "reviewer": "scribe"},
    {"id": 4, "domain": "PERF/NET", "lead": "runner", "reviewer": "tinker"},
    {"id": 5, "domain": "UX/DEP", "lead": "maker", "reviewer": "skeptic"},
    {"id": 6, "domain": "EXEC/OPS", "lead": "grunt", "reviewer": "verifier"}
  ],
  "agents": {
    "list": [
      {"name": "Lead", "id": "lead", "model": {"primary": "deepseek/deepseek-v4-flash", "fallbacks": ["ollama/llama3.2:3b"]}, "exec": "full"},
      {"name": "Skeptic", "id": "skeptic", "model": {"primary": "deepseek/deepseek-v4-flash", "fallbacks": ["ollama/llama3.2:3b"]}, "exec": "full"},
      {"name": "Verifier", "id": "verifier", "model": {"primary": "ollama/llama3.2:3b", "fallbacks": ["deepseek/deepseek-v4-flash"]}, "exec": "full"},
      {"name": "Guardian", "id": "guardian", "model": {"primary": "deepseek/deepseek-v4-flash", "fallbacks": ["ollama/llama3.2:3b"]}, "exec": "full"},
      {"name": "Tinker", "id": "tinker", "model": {"primary": "ollama/qwen2.5-coder:7b", "fallbacks": ["ollama/llama3.2:3b"]}, "exec": "full"},
      {"name": "Scribe", "id": "scribe", "model": {"primary": "ollama/llama3.2:3b", "fallbacks": ["deepseek/deepseek-v4-flash"]}, "exec": "full"},
      {"name": "Librarian", "id": "librarian", "model": {"primary": "ollama/llama3.2:3b", "fallbacks": ["deepseek/deepseek-v4-flash"]}, "exec": "full"},
      {"name": "Runner", "id": "runner", "model": {"primary": "ollama/llama3.2:3b", "fallbacks": ["deepseek/deepseek-v4-flash"]}, "exec": "full"},
      {"name": "Maker", "id": "maker", "model": {"primary": "deepseek/deepseek-v4-flash", "fallbacks": ["ollama/llama3.2:3b"]}, "exec": "full"},
      {"name": "Grunt", "id": "grunt", "model": {"primary": "ollama/llama3.2:3b", "fallbacks": ["deepseek/deepseek-v4-flash"]}, "exec": "full"}
    ]
  }
}
